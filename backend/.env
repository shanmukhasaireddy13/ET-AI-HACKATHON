# Application
APP_NAME=AutoExec AI Engine
API_HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Structured operational store (Supabase/Postgres in production)
DATABASE_URL=sqlite:///./agent_system.db
# SUPABASE_DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Unstructured agent memory store (MongoDB in production)
# MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=autoexec_ai

# Workspace defaults
WORKSPACE_NAME=default-workspace
DEFAULT_USER_EMAIL=system@autoexec.local

# Classifier mode: local | mock | provider
CLASSIFIER_MODE=provider
LLM_PROVIDER=groq

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq
GROQ_API_KEY=REMOVED
GROQ_MODEL=llama-3.1-8b-instant
